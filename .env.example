# Postgres
DB_USER=papertrade
DB_PASSWORD=papertrade
DB_NAME=papertrade

# Redis (used by Node + Go services)
REDIS_HOST=redis
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me

# Kafka (in-cluster hostname)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ENABLED=true

# AI service -> Node trade endpoint (in-cluster)
NODE_TRADE_URL=http://app:3000/api/v1/trading/trade

# Frontend -> backends (browser-side; uses host-published ports)
NEXT_PUBLIC_AI_API=http://localhost:8090
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NODE_API=http://app:3000
GO_API=http://trading-service:8081
