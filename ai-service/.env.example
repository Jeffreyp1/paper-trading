DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
KAFKA_ENABLED=true
KAFKA_TOPIC_SIGNALS=ai_signals
KAFKA_TOPIC_AUDIT=ai_audit
KAFKA_TOPIC_TICKS_IN=trade_events

NODE_TRADE_URL=http://app:3000/api/v1/trading/trade
MODEL_ARTIFACTS_DIR=/app/models_artifacts
AUTO_APPLY_MIGRATIONS=true
